---
import profileImage from "../assets/profile-image.webp";
import CommandHeading from "../components/CommandHeading.astro";
import { LINKS } from "../data/links";
---

<section id="home" class="term-section">
  <div class="term-section-inner">
    <CommandHeading command="whoami" comment="summary" />

    <div class="hero-grid">
      <div>
        <h1 class="hero-name">Abdulrhman Goni</h1>
        <p class="hero-role">Software Developer</p>
        <p class="hero-bio">
          Using <strong>JavaScript/TypeScript</strong>, I build web servers,
          applications and developer tools using modern web technologies, with a
          focus on developing <strong>back-end</strong> systems.
        </p>

        <div class="tui-panel hero-info">
          <span class="tui-panel-title">info</span>
          <div class="neofetch">
            <div class="neofetch-row">
              <span class="neofetch-key">user</span>
              <span>abdulrhman</span>
            </div>
            <div class="neofetch-row">
              <span class="neofetch-key">languages</span>
              <span>JavaScript/TypeScript, Go, Python</span>
            </div>
            <div class="neofetch-row">
              <span class="neofetch-key">email</span>
              <span>
                <a href={LINKS.email}>{LINKS.emailAddress}</a>
              </span>
            </div>
            <div class="neofetch-row">
              <span class="neofetch-key">github</span>
              <span>
                <a
                  href={LINKS.github}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  github.com/abdulrhmangoni
                </a>
              </span>
            </div>
            <div class="neofetch-row">
              <span class="neofetch-key">linkedin</span>
              <span>
                <a
                  href={LINKS.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  linkedin.com/in/abdulrhman-goni
                </a>
              </span>
            </div>
          </div>
        </div>
      </div>

      <div class="profile-frame">
        <div class="profile-frame-bar">
          <span>~/assets/profile.webp</span>
        </div>
        <img
          src={profileImage.src}
          alt="Portrait of Abdulrhman Goni"
          loading="eager"
          width="420"
          height="420"
        />
        <div class="profile-scan" aria-hidden="true"></div>
      </div>
    </div>

    <p class="continue-row">
      <a href="#projects">$ cd ./projects</a>
      <span class="cursor" aria-hidden="true"></span>
      <span class="comment"># see my work</span>
    </p>
  </div>
</section>
