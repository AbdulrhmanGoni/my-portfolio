---
import SkillBox from "../components/SkillBox.astro";
import CommandHeading from "../components/CommandHeading.astro";
import { skillsData } from "../data/skills";
---

<section id="skills" class="term-section">
  <div class="term-section-inner">
    <CommandHeading command="cat ./skills.json" comment="tech stack" />

    <div class="tui-panel">
      {
        Object.entries(skillsData).map(([title, skills]) => (
          <div class="skills-group">
            <h2>{title}</h2>
            <div class="skills-row">
              {skills.map((skill) => (
                <SkillBox skill={skill} />
              ))}
            </div>
          </div>
        ))
      }
    </div>
  </div>
</section>
