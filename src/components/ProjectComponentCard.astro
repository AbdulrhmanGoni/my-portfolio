---
import type { ProjectData } from "../data/projects";
import TermButton from "./TermButton.astro";
import TechStackList from "./TechStackList.astro";

interface Props {
	project: ProjectData;
	index: number;
}

const { project, index } = Astro.props;
---

<article class="component-card">
	<img
		src={project.image}
		loading={index > 0 ? "lazy" : undefined}
		alt={project.imageAlt}
	/>
	<div class="component-body">
		<h4>{project.name}</h4>
		<p>{project.description}</p>
		<TechStackList techStack={project.techStack} size="small" />
		<TermButton link={project.repoUrl} text="git clone" ghost size="sm" />
	</div>
</article>
