<dialog id="help-dialog" class="help-dialog" tabindex="-1">
  <div class="help-dialog-panel">
    <div class="help-dialog-bar">
      <span>man portfolio</span>
      <button
        type="button"
        onclick="document.getElementById('help-dialog').close()"
      >
        [esc] close
      </button>
    </div>
    <pre>
<span class="man-name">NAME</span>
    portfolio — interactive terminal resume for Abdulrhman Goni

<span class="man-name">SYNOPSIS</span>
    command [args]

<span class="man-name">COMMANDS</span>
    whoami, about, neofetch   identity / home
    ls, ls projects           list files or projects
    cd [home|projects|skills]
    cat [file]                read a section
    skills                    tech stack
    contact, email            contact info / mailto
    github, linkedin          open profiles
    clear                     scroll to top
    pwd, date, echo           shell toys
    help, man, ?              this page

<span class="man-name">KEYS</span>
    / or :     focus the prompt
    1 2 3      jump sections
    Esc        close dialogs / leave insert
    ?          open this manual
			</pre>
  </div>
</dialog>
