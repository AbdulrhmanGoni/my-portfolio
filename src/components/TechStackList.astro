---
import type { ProjectData } from "../data/projects";

interface Props {
	techStack: ProjectData["techStack"];
	size?: "base" | "small";
}

const { techStack, size = "base" } = Astro.props;
---

<div class={size == "small" ? "mb-1" : undefined}>
	<p class={`font-semibold mb-2 ${size == "small" ? "text-[11px]" : "text-xs"} text-primary tracking-wider uppercase`}>
		# stack
	</p>
	<div class={`flex flex-wrap ${size == "small" ? "gap-1.5" : "gap-2"}`}>
		{
			techStack.map((tech) => (
				<span class="chip">{tech}</span>
			))
		}
	</div>
</div>
