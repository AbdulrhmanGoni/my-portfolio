---
import type { ProjectData } from "../data/projects";

interface Props {
	techStack: ProjectData["techStack"];
	size?: "base" | "small";
}

const { techStack, size = "base" } = Astro.props;
---

<div class={size == "small" ? "tech-stack tech-stack--sm" : "tech-stack"}>
	<p class="tech-stack-label"># stack</p>
	<div class="tech-stack-chips">
		{
			techStack.map((tech) => (
				<span class="chip">{tech}</span>
			))
		}
	</div>
</div>
