---
import TerminalPrompt from "./TerminalPrompt.astro";

interface Props {
  command: string;
  comment?: string;
}

const { command, comment } = Astro.props;
---

<p class="cmd-line">
  <TerminalPrompt />
  <span class="cmd">{command}</span>
  {comment && <span class="comment"># {comment}</span>}
</p>
