---
interface Props {
  command: string;
  comment?: string;
}

const { command, comment } = Astro.props;
---

<p class="cmd-line">
  <span class="user">abdulrhman</span>
  <span class="sep">@</span>
  <span class="host">portfolio</span>
  <span class="sep">:</span>
  <span class="path">~</span>
  <span class="dollar">$</span>
  <span class="cmd">{command}</span>
  {comment && <span class="comment"># {comment}</span>}
</p>
