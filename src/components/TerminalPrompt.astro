---
interface Props {
  path?: string;
  class?: string;
}

const { path = "~", class: className } = Astro.props;
---

<span class:list={["term-prompt", className]}>
  <span class="prompt-user">abdulrhman</span>
  <span class="prompt-at">@</span>
  <span class="prompt-host">portfolio</span>
  <span class="prompt-colon">:</span>
  <span class="prompt-path">{path}</span>
  <span class="prompt-dollar">$</span>
</span>

<style>
  .term-prompt {
    font-size: 13px;
    white-space: nowrap;
  }

  .prompt-user {
    color: var(--color-primary);
    font-weight: 600;
  }

  .prompt-at,
  .prompt-colon {
    color: var(--color-muted-foreground);
    font-weight: 400;
  }

  .prompt-host,
  .prompt-path {
    color: var(--color-primary-soft);
  }

  .prompt-dollar {
    color: var(--color-primary);
    font-weight: 700;
  }
</style>
