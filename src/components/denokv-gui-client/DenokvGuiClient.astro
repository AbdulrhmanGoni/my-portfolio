---
import AppWindow from "../desktop/AppWindow.astro";
import releaseInfoJson from "../../data/denokv-gui-client-release.json";
import {
  formatReleaseVersion,
  type DenokvReleaseInfo,
} from "./release-info";

const releaseInfo = releaseInfoJson as DenokvReleaseInfo;

const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const clientUrl = `${base}denokv-gui-client`;
---

<!--
  The window is created the first time its dock icon is clicked, so its markup
  lives in a template until then.
-->
<template data-app-template="denokv-gui-client">
  <AppWindow
    id="denokv-gui-client-window"
    appId="denokv-gui-client"
    dock="denokv-gui-client"
    meta={formatReleaseVersion(releaseInfo)}
    initialWidth={1180}
    initialHeight={690}
  >
    <span slot="title">denokv-gui-client</span>

    <iframe
      class="denokv-gui-client-frame"
      src={clientUrl}
      title="denokv-gui-client"
      loading="lazy"
    >
    </iframe>
  </AppWindow>
</template>
