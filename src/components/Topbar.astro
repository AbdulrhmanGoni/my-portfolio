---
import cpuIcon from "../assets/desktop/topbar_icons/cpu.svg";
import memoryIcon from "../assets/desktop/topbar_icons/memory.svg";
import storageIcon from "../assets/desktop/topbar_icons/storage.svg";
import networkIcon from "../assets/desktop/topbar_icons/network.svg";
import volumeIcon from "../assets/desktop/topbar_icons/volume.svg";
import powerIcon from "../assets/desktop/topbar_icons/power.svg";

const dateFormatter = new Intl.DateTimeFormat("en-US", {
  weekday: "short",
  month: "short",
  day: "numeric",
  hour: "numeric",
  minute: "2-digit",
  hour12: true,
});
---

<div id="topbar">
  <div></div>
  <div>
    <span class="topbar-item">
      {dateFormatter.format(new Date()).replace(/,/g, "")}
    </span>
  </div>
  <div>
    <div class="vitals topbar-item">
      <div class="vital-item">
        <img src={cpuIcon.src} />
        <span>3%</span>
      </div>
      <div class="vital-item">
        <img src={memoryIcon.src} />
        <span>31%</span>
      </div>
      <div class="vital-item">
        <img src={storageIcon.src} />
        <span style="display: flex;gap: 2px">
          <span>204</span>
          <span>GB</span>
        </span>
      </div>
    </div>
    <div class="system-status topbar-item">
      <img src={networkIcon.src} />
      <img src={volumeIcon.src} />
      <img src={powerIcon.src} />
    </div>
  </div>
</div>
