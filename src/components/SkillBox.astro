---
import type { Skill } from "../data/skills";

interface Props {
	skill: Skill;
}

const { skill } = Astro.props;
---

<div
	class="skill-box tooltip-target"
	data-tooltip={skill.description}
	tabindex="0"
>
	<img
		loading="lazy"
		src={skill.imgSrc}
		alt={skill.description}
		style={skill.imgStyle}
	/>
	<span class="skill-name">{skill.name}</span>
</div>
