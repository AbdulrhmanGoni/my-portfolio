---
import braveIcon from "../assets/desktop/sidebar_applications/brave.webp";
import filesIcon from "../assets/desktop/sidebar_applications/files.webp";
import terminalIcon from "../assets/desktop/sidebar_applications/terminal.webp";
import vscodeIcon from "../assets/desktop/sidebar_applications/vscode.webp";
import dockerIcon from "../assets/desktop/sidebar_applications/docker-desktop.webp";
import denokvGuiClientIcon from "../assets/desktop/sidebar_applications/denokv-gui-client.webp";
import opencodeIcon from "../assets/desktop/sidebar_applications/opencode.webp";
import settingsIcon from "../assets/desktop/sidebar_applications/settings.webp";
import trashIcon from "../assets/desktop/sidebar_applications/trash.webp";
---

<div id="sidebar">
  <ul>
    <li><img src={braveIcon.src} /></li>
    <li><img src={filesIcon.src} /></li>
    <li class="active is-focused">
      <button
        id="terminal-app"
        aria-label="Terminal"
        aria-controls="terminal-window"
        aria-expanded="true">
        <img src={terminalIcon.src} />
      </button>
    </li>
    <li><img src={vscodeIcon.src} /></li>
    <li><img src={dockerIcon.src} /></li>
    <li><img src={denokvGuiClientIcon.src} /></li>
    <li><img src={opencodeIcon.src} /></li>
    <li><img src={settingsIcon.src} /></li>
    <span class="separator-x"></span>
    <li>
      <img src={trashIcon.src} />
    </li>
  </ul>
  <div id="show-apps-icon">
    <svg version="1.1" viewBox="0 0 16 16" xmlns="http://www.w3.org/2000/svg">
      <g fill="#ffffff">
        <path
          d="m10.176 10.551a1.675 1.675 0 0 1 1.6738 1.6738 1.675 1.675 0 0 1-1.6738 1.6758 1.675 1.675 0 0 1-1.6758-1.6758 1.675 1.675 0 0 1 1.6758-1.6738z"
        ></path>
        <path
          d="m4.5898 10.086a4.04 4.04 0 0 0 2.7754 2.125 1.445 1.445 0 0 0 0.41016 0.06445 2.355 2.355 0 0 0 0.5 1.4004 5.5 5.5 0 0 1-1.1855-0.125 5.435 5.435 0 0 1-3.9258-3.291 2.415 2.415 0 0 0 1.4258-0.17383z"
        ></path>
        <path
          d="m3.5898 6.2344a1.675 1.675 0 0 1 1.6758 1.6758 1.675 1.675 0 0 1-1.6758 1.6758 1.675 1.675 0 0 1-1.6758-1.6758 1.675 1.675 0 0 1 1.6758-1.6758z"
        ></path>
        <path
          d="m12.775 5.1992a5.5 5.5 0 0 1-0.27539 6.416 2.29 2.29 0 0 0-0.80078-1.2402 4.04 4.04 0 0 0 0.52539-1.3008 4.11 4.11 0 0 0-0.38867-2.7734 2.425 2.425 0 0 0 0.93945-1.1016z"
        ></path>
        <path
          d="m8.1191 2.7402a5.5 5.5 0 0 1 0.51562 0.015625 2.315 2.315 0 0 0-0.45898 0.97461 3.21 3.21 0 0 0-0.050781 0.375 4.06 4.06 0 0 0-3.2891 1.7598 2.42 2.42 0 0 0-0.76172-0.31445 2.325 2.325 0 0 0-0.5-0.050781h-0.125a5.5 5.5 0 0 1 4.6699-2.7598z"
        ></path>
        <path
          d="m10.551 2.5645a1.675 1.675 0 0 1 1.6738 1.6758 1.675 1.675 0 0 1-1.6738 1.6738 1.675 1.675 0 0 1-1.6758-1.6738 1.675 1.675 0 0 1 1.6758-1.6758z"
        ></path>
      </g>
    </svg>
  </div>
</div>
