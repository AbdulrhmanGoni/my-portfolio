---
import AppWindow from "./AppWindow.astro";
import EmbeddedApp from "./EmbeddedApp.astro";

// The window is created the first time the VS Code dock icon is clicked, so
// its markup lives in a template until then.
const base = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const clientUrl = `${base}vscode`;
---

<template data-app-template="vscode">
  <AppWindow id="vscode-window" appId="vscode" dock="vscode">
    <span slot="title">Visual Studio Code</span>

    <EmbeddedApp src={clientUrl} title="Visual Studio Code" />
  </AppWindow>
</template>
