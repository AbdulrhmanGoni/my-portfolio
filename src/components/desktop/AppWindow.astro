---
import closeIcon from "../../assets/desktop/window-controls/close.svg?raw";
import maximizeIcon from "../../assets/desktop/window-controls/maximize.svg?raw";
import minimizeIcon from "../../assets/desktop/window-controls/minimize.svg?raw";
import restoreIcon from "../../assets/desktop/window-controls/restore.svg?raw";

// Shared desktop window chrome. Application-specific content goes in the
// default slot; the title is supplied through the "title" slot.
//
// Feature flags are written to the element as data attributes and read back by
// the window registry, so they must stay in sync with the values the registry
// expects (see src/scripts/windows/registry.ts). The preferred initial size is
// written as CSS custom properties instead: the stylesheet needs it before any
// script runs, so the window never flashes at the wrong size.
interface Props {
  /** DOM id of the window element. */
  id: string;
  /** Stable identifier used to look the window up via `getAppWindow()`. */
  appId: string;
  /**
   * Identifier of the dock icon that opens and restores this window. A window
   * without a dock cannot be minimized — there would be no way to bring it
   * back — so its minimize button is hidden.
   */
  dock?: string;
  /** Extra classes applied to the window element. */
  class?: string;
  /** Smallest width the window may be resized to, in pixels. */
  minWidth?: number;
  /** Smallest height the window may be resized to, in pixels. */
  minHeight?: number;
  /**
   * Desired initial width in pixels. The window opens centered and shrinks to
   * the available desktop width when the desktop is smaller than this.
   */
  initialWidth?: number;
  /**
   * Desired initial height in pixels. The window opens centered and shrinks to
   * the available desktop height when the desktop is smaller than this.
   */
  initialHeight?: number;
  /** Whether the titlebar can be dragged to move the window. */
  draggable?: boolean;
  /** Whether the window can be resized from its edges and corners. */
  resizable?: boolean;
  /** Whether the window can be minimized into its dock icon. */
  minimizable?: boolean;
  /** Whether the window can be maximized to fill the desktop. */
  maximizable?: boolean;
  /**
   * Whether the window can be closed and disposed. Windows that are recreated
   * from a template can be closed and reopened; windows without a factory
   * should opt out.
   */
  closable?: boolean;
}

const {
  id,
  appId,
  dock,
  class: className,
  minWidth,
  minHeight,
  initialWidth,
  initialHeight,
  draggable,
  resizable,
  minimizable,
  maximizable,
  closable,
} = Astro.props;

// Inline custom properties, so the preferred size applies from the first paint.
const initialSizeStyle = [
  initialWidth !== undefined && `--window-initial-width: ${initialWidth}px;`,
  initialHeight !== undefined && `--window-initial-height: ${initialHeight}px;`,
]
  .filter(Boolean)
  .join(" ");
---

<div
  id={id}
  class:list={["app-window", className]}
  style={initialSizeStyle || undefined}
  data-app-window
  data-app-id={appId}
  data-dock={dock}
  data-min-width={minWidth}
  data-min-height={minHeight}
  data-draggable={String(draggable !== false)}
  data-resizable={String(resizable !== false)}
  data-minimizable={String(minimizable !== false)}
  data-maximizable={String(maximizable !== false)}
  data-closable={String(closable !== false)}
>
  <header class="titlebar">
    <div class="titlebar-title">
      <slot name="title" />
    </div>
    <div class="window-controls" role="group" aria-label="window controls">
      {
        closable !== false ? (
          <button
            class="window-control close"
            data-window-action="close"
            title="close"
            aria-label="Close"
            aria-controls={id}
            set:html={closeIcon}
          />
        ) : (
          <span
            class="window-control close"
            aria-hidden="true"
            set:html={closeIcon}
          />
        )
      }
      <button
        class="window-control minimize"
        data-window-action="minimize"
        title="minimize"
        aria-label="Minimize"
        aria-controls={id}
        aria-pressed="false"
        set:html={minimizeIcon}></button>
      <button
        class="window-control maximize"
        data-window-action="maximize"
        title="maximize"
        aria-label="Maximize"
        aria-controls={id}
        aria-pressed="false">
        <span
          class="window-control-icon maximize-icon"
          aria-hidden="true"
          set:html={maximizeIcon}
        />
        <span
          class="window-control-icon restore-icon"
          aria-hidden="true"
          set:html={restoreIcon}
        />
      </button>
    </div>
  </header>

  <slot />

  <div class="resize-handles" aria-hidden="true">
    <div class="resize-handle" data-resize="n"></div>
    <div class="resize-handle" data-resize="s"></div>
    <div class="resize-handle" data-resize="e"></div>
    <div class="resize-handle" data-resize="w"></div>
    <div class="resize-handle" data-resize="ne"></div>
    <div class="resize-handle" data-resize="nw"></div>
    <div class="resize-handle" data-resize="se"></div>
    <div class="resize-handle" data-resize="sw"></div>
  </div>
</div>
