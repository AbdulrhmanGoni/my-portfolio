---
// Shared wrapper for applications that run in an iframe.
//
// It shows a spinner over the content area until the embedded app reports that
// it has mounted (see src/scripts/windows/embedded-app.ts), so opening a heavy
// app never leaves the window blank while its page and scripts load.
interface Props {
  /** URL of the embedded application. */
  src: string;
  /** Accessible name of the framed application. */
  title: string;
}

const { src, title } = Astro.props;
---

<div class="embedded-app" data-embedded-app>
  <iframe {src} {title}></iframe>
  <div class="embedded-app-loading" aria-hidden="true">
    <span class="embedded-app-spinner"></span>
  </div>
</div>

<style>
  .embedded-app {
    position: relative;
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .embedded-app iframe {
    flex: 1;
    width: 100%;
    min-height: 0;
    border: 0;
    background: var(--color-background);
  }

  .embedded-app-loading {
    position: absolute;
    inset: 0;
    display: grid;
    place-items: center;
    background: var(--color-background);
    transition: opacity 150ms ease;
  }

  .embedded-app.is-ready .embedded-app-loading {
    opacity: 0;
    visibility: hidden;
    transition:
      opacity 150ms ease,
      visibility 0s 150ms;
  }

  .embedded-app-spinner {
    width: 26px;
    height: 26px;
    border: 2px solid var(--color-border);
    border-top-color: var(--color-primary);
    border-radius: 50%;
    animation: embedded-app-spin 700ms linear infinite;
  }

  @keyframes embedded-app-spin {
    to {
      transform: rotate(360deg);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .embedded-app-spinner {
      animation-duration: 1.8s;
    }
  }
</style>
